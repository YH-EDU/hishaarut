# Public client settings only. Never put an sb_secret_ or service_role key here.
# The client accepts either a legacy anon JWT or a key that starts with sb_publishable_.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_YOUR_KEY

# Optional. Deployment subpath, for example /hishaarut/ on GitHub Pages.
# Leave unset or use / for Vercel and local dev.
VITE_BASE_PATH=/

# Optional hint passed to Google as the hosted-domain (hd) parameter.
# The real restriction is school_settings.allowed_email_domain in the database.
VITE_GOOGLE_HD=
